      <sheets>
        <sheet>
          <plain>
            <text x="10.16" y="91.44" size="3.81" layer="97">SmartTraffic | Shield Arduino UNO R3</text>
            <text x="10.16" y="85.09" size="2.032" layer="97">Borrador: base del UNO y propuesta de UART</text>
            <wire x1="93.98" y1="58.42" x2="156.21" y2="58.42" width="0.254" layer="97" />
            <wire x1="156.21" y1="58.42" x2="156.21" y2="74.93" width="0.254" layer="97" />
            <wire x1="156.21" y1="74.93" x2="93.98" y2="74.93" width="0.254" layer="97" />
            <wire x1="93.98" y1="74.93" x2="93.98" y2="58.42" width="0.254" layer="97" />
            <text x="96.52" y="71.12" size="1.778" layer="97">ESP32 / WIFI</text>
            <text x="96.52" y="67.31" size="1.524" layer="97">JP1 abierto durante carga o uso del USB serial.</text>
            <text x="96.52" y="64.77" size="1.524" layer="97">El ESP32 requiere su propia alimentacion.</text>
            <text x="96.52" y="62.230000000000004" size="1.524" layer="97">J5 recibe la referencia de 3.3 V del ESP32.</text>
            <wire x1="93.98" y1="35.56" x2="156.21" y2="35.56" width="0.254" layer="97" />
            <wire x1="156.21" y1="35.56" x2="156.21" y2="52.07" width="0.254" layer="97" />
            <wire x1="156.21" y1="52.07" x2="93.98" y2="52.07" width="0.254" layer="97" />
            <wire x1="93.98" y1="52.07" x2="93.98" y2="35.56" width="0.254" layer="97" />
            <text x="96.52" y="48.26" size="1.778" layer="97">NUEVE SEMAFOROS</text>
            <text x="96.52" y="44.45" size="1.524" layer="97">27 canales independientes como base.</text>
            <text x="96.52" y="41.910000000000004" size="1.524" layer="97">Usar las resistencias instaladas en cada LED.</text>
            <text x="96.52" y="39.370000000000005" size="1.524" layer="97">Reparto candidato: 15 UNO + 12 ESP32.</text>
            <wire x1="93.98" y1="12.7" x2="156.21" y2="12.7" width="0.254" layer="97" />
            <wire x1="156.21" y1="12.7" x2="156.21" y2="29.21" width="0.254" layer="97" />
            <wire x1="156.21" y1="29.21" x2="93.98" y2="29.21" width="0.254" layer="97" />
            <wire x1="93.98" y1="29.21" x2="93.98" y2="12.7" width="0.254" layer="97" />
            <text x="96.52" y="25.400000000000002" size="1.778" layer="97">ARRANQUE EN ROJO</text>
            <text x="96.52" y="21.59" size="1.524" layer="97">Forzar rojo durante reset o perdida de enlace.</text>
            <text x="96.52" y="19.05" size="1.524" layer="97">Validar mapa, todo rojo, cierres y pruebas</text>
            <text x="96.52" y="16.509999999999998" size="1.524" layer="97">antes de habilitar el ciclo automatico.</text>
            <text x="160.02" y="85.09" size="2.54" layer="97">UART UNO / ESP32 - PROPUESTA</text>
            <text x="160.02" y="78.74" size="1.524" layer="97">J5: comprobar pines y nivel logico del modulo elegido.</text>
            <text x="160.02" y="3.81" size="1.524" layer="97">Abrir JP1 al programar por USB; cerrar solo para el enlace Wi-Fi.</text>
          </plain>
